{
  "expo": {
    "name": "Hadman Factor",
    "slug": "hadman-factor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.hadonix.hadmanfactor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "ir.hadonix.hadmanfactor"
    },
    "plugins": [
      "expo-dev-client",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-sqlite"
    ]
  }
}